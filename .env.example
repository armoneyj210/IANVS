# ============================================================
# JANUS
# Environment Variable Template
#
# Safe to commit.
# Copy to .env and supply local secrets.
# ============================================================

# Application
JANUS_ENV=development
COMPOSE_PROJECT_NAME=janus
LOG_LEVEL=info

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=therapy

# PostgreSQL bootstrap/admin
POSTGRES_USER=therapy_app
POSTGRES_PASSWORD=

# Migration service
JANUS_MIGRATOR_DB_USER=janus_migrator_svc
JANUS_MIGRATOR_DB_PASSWORD=

# ETL service
JANUS_ETL_DB_USER=janus_etl_svc
JANUS_ETL_DB_PASSWORD=

# Patient API service
JANUS_API_DB_USER=janus_api_svc
JANUS_API_DB_PASSWORD=

# Digital Twin service
JANUS_TWIN_DB_USER=janus_twin_svc
JANUS_TWIN_DB_PASSWORD=

# Simulation service
JANUS_SIMULATION_DB_USER=janus_simulation_svc
JANUS_SIMULATION_DB_PASSWORD=

# Operations / telemetry service
JANUS_OPS_DB_USER=janus_ops_svc
JANUS_OPS_DB_PASSWORD=